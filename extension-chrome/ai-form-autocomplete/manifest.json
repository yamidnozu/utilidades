{
    "manifest_version": 3,
    "name": "AI Form Autocomplete",
    "version": "1.0",
    "description": "Detecta, analiza y autocompleta formularios dinámicos utilizando IA.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "contentScript.js"
            ],
            "css": [
                "styles/content.css"
            ]
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "assets/icon.png",
            "48": "assets/icon.png",
            "128": "assets/icon.png"
        }
    },
    "icons": {
        "16": "assets/icon.png",
        "48": "assets/icon.png",
        "128": "assets/icon.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "styles/content.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
